{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "IML AST Arena (UTF-8)",
  "type": "object",
  "properties": {
    "nodes": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "t": {
            "description": "Node Type / Opcode",
            "anyOf": [
              { "type": "string", "enum": ["L", "D", "V", "T", "C", "B", "P"] },
              {
                "type": "object",
                "properties": {
                  "L": { "type": ["null", "object"] },
                  "D": { "type": ["null", "object"] },
                  "V": { "type": ["null", "object"] },
                  "T": { "type": ["null", "object"] },
                  "C": { "type": ["null", "object"] },
                  "B": { "type": ["null", "object"] },
                  "P": { "type": ["null", "object"] }
                },
                "additionalProperties": false,
                "minProperties": 1,
                "maxProperties": 1
              }
            ]
          },
          "c": {
            "description": "Children / Input dependency indices",
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": 0
            }
          },
          "r": {
            "description": "Semantic Rationale",
            "type": "string"
          },
          "o": {
            "description": "Output / Resource Handle Identifier",
            "type": "string"
          },
          "a": {
            "description": "Inline Arguments / Literals",
            "type": ["string", "number", "boolean", "object", "array", "null"]
          }
        },
        "required": ["t", "c"]
      }
    }
  },
  "required": ["nodes"]
}
